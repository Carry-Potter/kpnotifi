# --- Baza ---
# Lokalno (docker compose up -d):
DATABASE_URL=postgres://kpnotifi:kpnotifi@localhost:5433/kpnotifi
# Na Neon-u izgleda ovako (obavezno sslmode=require):
# DATABASE_URL=postgres://user:pass@ep-nesto.eu-central-1.aws.neon.tech/kpnotifi?sslmode=require

# --- Telegram ---
# Token dobijaš od @BotFather (komanda /newbot)
TELEGRAM_BOT_TOKEN=

# Javna adresa servisa, bez kose crte na kraju. Koristi se za webhook i za link ka sajtu.
# Lokalno ostavi prazno -> bot radi u polling režimu.
PUBLIC_URL=

# --- Interno ---
# Tajna za POST /internal/tick (spoljni cron ga zove). Izmisli dugačak nasumičan niz.
TICK_SECRET=promeni-me

PORT=3000

# Kontakt koji se šalje KP-u u User-Agent zaglavlju (fer ponašanje prema sajtu)
KP_CONTACT=kpnotifi (kontakt: tvoj-mejl@primer.com)

# Najmanji razmak između dva zahteva ka KP-u, u milisekundama
KP_MIN_DELAY_MS=2000

# Koliko često se proverava jedan feed, u minutima
POLL_INTERVAL_MINUTES=5

# --- Nadzor i limiti ---
# Tvoj Telegram ID (broj) — stižu ti alarmi kad scraping krene da puca.
# Svoj ID saznaš npr. od @userinfobot. Prazno = nadzor isključen.
ADMIN_TELEGRAM_ID=

# Najviše pretraga po korisniku
MAX_SEARCHES_PER_USER=10

# Odbij snimanje pretrage koja trenutno pogađa više oglasa od ovoga
MAX_RESULTS_PER_SEARCH=10000

# (produkcija) GitHub fine-grained PAT sa "Actions: write" samo za ovaj repo —
# server njime pokreće worker na zahtev (pregled/nova pretraga bez čekanja crona)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Carry-Potter/kpnotifi
