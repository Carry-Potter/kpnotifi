{
  "name": "kpnotifi",
  "version": "0.1.0",
  "private": true,
  "description": "KP Notify - pracenje oglasa na KupujemProdajem i obavestenja preko Telegrama",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "kp:probe": "npm run kp:probe --workspace server --",
    "migrate": "npm run migrate --workspace server",
    "build": "npm run build --workspace web"
  },
  "engines": {
    "node": ">=24"
  }
}
