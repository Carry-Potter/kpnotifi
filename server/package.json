{
  "name": "@kpnotifi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "kp:probe": "node --env-file-if-exists=../.env src/kp/probe.ts",
    "catalog:seed": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.worker src/kp/seed.ts",
    "worker": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.worker src/worker.ts",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "grammy": "^1.34.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
